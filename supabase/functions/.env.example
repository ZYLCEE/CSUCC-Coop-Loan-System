# Local Edge Function secrets only. Copy to supabase/functions/.env and fill in
# values locally. Never place these credentials in browser or Flutter .env files.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your-project-mailbox@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-project-mailbox@gmail.com
COOP_MEMBER_APP_URL=https://your-member-app.example
COOP_EMAIL_WORKER_TOKEN=generate-a-long-random-secret
